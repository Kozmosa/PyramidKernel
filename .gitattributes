# Keep source files stable across Linux, macOS, and Windows checkouts.
* text=auto
*.py text
*.sh text eol=lf
*.yaml text
*.yml text
*.md text
*.toml text
*.json text
*.csv text
*.tsv text

# Generated or binary artifacts should never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.pt binary
*.pth binary
*.safetensors binary
